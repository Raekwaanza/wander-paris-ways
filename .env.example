# Public, non-sensitive provider/configuration selection. Supported values:
# mock, live. The current hybrid provider set always attempts server-backed
# MapTiler/ORS operations when their server keys exist and otherwise uses
# seeded search or Preview routes. "live" remains reserved for a future fully
# live provider set; it currently warns and reports the hybrid set as active.
VITE_SCENIC_DATA_MODE=mock

# Server-only credential used for Paris forward search and best-effort reverse
# label enrichment of browser GPS fixes.
MAPTILER_API_KEY=

# Server-only credential for ORS foot-walking directions, alternatives, and
# Wander Matrix/via requests. When unavailable, product routes safely fall
# back to synthetic Preview geometry.
OPENROUTESERVICE_API_KEY=

# Public MapLibre style URL. Defaults to OpenFreeMap Liberty when omitted.
# VITE_SCENIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
