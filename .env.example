# Public, non-sensitive provider selection. Supported values: mock, live.
# Missing, empty, or invalid values safely use mock. Live currently emits a
# developer warning and explicitly falls back to the mock provider set.
VITE_SCENIC_DATA_MODE=mock

# Public MapLibre style URL. Defaults to OpenFreeMap Liberty when omitted.
# VITE_SCENIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
