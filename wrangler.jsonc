{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scenic-route",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Scenic Route's custom TanStack server entry preserves its SSR error handling.
  "main": "src/server.ts",
  "ratelimits": [
    {
      "name": "SCENIC_API_BURST_RATE_LIMITER",
      "namespace_id": "21001",
      "simple": { "limit": 30, "period": 10 },
    },
    {
      "name": "SCENIC_API_SUSTAINED_RATE_LIMITER",
      "namespace_id": "21002",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "SCENIC_GEOCODING_RATE_LIMITER",
      "namespace_id": "21003",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "SCENIC_ROUTING_RATE_LIMITER",
      "namespace_id": "21004",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "SCENIC_MATRIX_RATE_LIMITER",
      "namespace_id": "21005",
      "simple": { "limit": 12, "period": 60 },
    },
  ],
  "secrets": {
    "required": ["OPENROUTESERVICE_API_KEY", "MAPTILER_API_KEY"],
  },
}
